{
  "version": "0.2",
  "import": [
    "../../.cspell.common.json"
  ],
  "ignorePaths": [
    "node_modules",
    ".git",
    "**/dist",
    "**/build",
    "**/*.min.js"
  ],
  "words": [
    "Formspree",
    "Garreau",
    "vincentgarreau",
    "Affero",
    "AGPL",
    "Migadu",
    "multispectral",
    "bushfires",
    "Turnstile",
    "OpenGraph",
    "webmanifest"
  ],
  "languageSettings": [
    {
      "languageId": "html",
      "dictionaries": ["html", "css", "en-au", "charlie-user-words"]
    },
    {
      "languageId": "css",
      "dictionaries": ["css"]
    },
    {
      "languageId": "markdown",
      "dictionaries": ["en-au", "charlie-user-words"]
    },
    {
      "languageId": "javascript",
      "dictionaries": ["javascript", "node", "npm"]
    },
    {
      "languageId": "typescript",
      "dictionaries": ["typescript", "node", "npm"]
    }
  ]
}